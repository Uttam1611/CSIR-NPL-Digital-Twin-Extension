# Copy to .env (next to inference_server.py) and fill in real values.
# .env should NOT be committed to version control.

DT_PG_HOST=localhost
DT_PG_PORT=5432
DT_PG_DATABASE=digital_twin
DT_PG_USER=digital_twin
DT_PG_PASSWORD=changeme
DT_PG_MINCONN=1
DT_PG_MAXCONN=5
DT_PG_CONNECT_TIMEOUT=5
DT_PG_SSLMODE=prefer

# Set to "true" to also store the full (17, 769) gzip-compressed feature
# matrix per cycle (BYTEA). Off by default -- see storage/schema.py docstring
# for the disk-usage tradeoff.
DT_STORE_FEATURE_MATRIX=false

# Number of recent readings kept per channel for Type A (statistical) uncertainty
DT_TYPE_A_WINDOW=30

# Optional path to a JSON file overriding uncertainty/type_b.py's default
# instrument specs (see that file's load_channel_specs()).
# UNCERTAINTY_CONFIG_PATH=./channel_specs.json
